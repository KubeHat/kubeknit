#!/usr/bin/env bash

[[ -n ${DEBUG:-} ]] && set -x

set -eEuo pipefail

readonly KNIT_VERSION="v0.1.0"

# private temp directory in $TMPDIR, never in the (maybe read-only) working dir
WORKDIR=""
cleanup() {
  if [[ -n "$WORKDIR" ]]; then
    rm -rf -- "$WORKDIR"
  fi
}
trap cleanup EXIT

usage() {
  cat <<'EOF'
kubectl knit imports, deletes, merges and exports kubeconfig files

USAGE:
  kubectl knit merge [--preserve-structure,-p] <CONFIG>..
     Merge multiple kubeconfigs into one.
     -p  prevents flattening which will make the result less portable.

  kubectl knit import [--preserve-structure,-p] [--save,-s] [--force,-f] [--stdin,-i] <CONFIG>..
     Import the given configs into your kubeconfig. Your kubeconfig is the first
     file in the KUBECONFIG env var, or ~/.kube/config if KUBECONFIG is unset.
     -s  writes the result to your kubeconfig instead of printing it
     -f  overwrites existing clusters, users and contexts with the same name
     -i  import kubeconfig string from stdin (same as passing "-" as CONFIG)
     -p  prevents flattening; relative certificate paths are made absolute

  kubectl knit delete [--save,-s] [--context-only,-c] <CONTEXT>..
     Delete the given contexts from your kubeconfig. Clusters and users that are
     no longer used by any remaining context are deleted as well.
     Without -s, only shows what would be deleted (the resulting kubeconfig is
     printed when stdout is redirected or piped).
     -s  writes the result to your kubeconfig
     -c  only deletes the contexts, but keeps their clusters and users

  kubectl knit split  <CONTEXT>.. [--kubeconfig,-k <CONFIG>]
  kubectl knit export <CONTEXT>.. [--kubeconfig,-k <CONFIG>]
     Export/split off a minimal kubeconfig with the given contexts
      -k  may be repeated or contain a comma-delimited list of input configs.
          When omitted, export from the default kubeconfig.

  kubectl knit completion (bash|zsh)
     Print a shell completion script.

  kubectl knit version
     Print the version.

EXAMPLES:
  Merge new-cfg with your current kubeconfig
    $ kubectl knit import new-cfg
  and save the result to ~/.kube/config
    $ kubectl knit import --save new-cfg
  CAVEAT: due to how shells work, the following will lose your current ~/.kube/config
    WRONG $ kubectl knit import new-cfg > ~/.kube/config

  Remove context ctx1 together with its cluster and user from ~/.kube/config
    $ kubectl knit delete --save ctx1

  Export ctx1 and ctx2 into combined.yaml
    $ kubectl knit export -k ~/.kube/config -k k3s.yaml ctx1 ctx2 > combined.yaml

  Merge two configs
    $ kubectl knit merge ~/.kube/config k3s.yaml > merged-and-flattened
    or
    $ kubectl knit merge -p ~/.kube/config k3s.yaml > merged-not-flattened

  Enable shell completion
    $ source <(kubectl knit completion bash)

EOF
}

completion() {
  local shell="${1:-}"
  case "$shell" in
    bash) ;;
    zsh)
      echo 'autoload -U +X bashcompinit && bashcompinit'
      ;;
    '')
      error "shell is missing, use \"completion bash\" or \"completion zsh\""
      ;;
    *)
      error "unsupported shell \"$shell\", use \"bash\" or \"zsh\""
      ;;
  esac

  cat <<'COMPLETION'
_kubectl_knit_contexts() {
  local i cfgs=""
  for (( i = 2; i < COMP_CWORD; i++ )); do
    if [[ "${COMP_WORDS[i]}" == '-k' || "${COMP_WORDS[i]}" == '--kubeconfig' ]]; then
      cfgs="${cfgs:+$cfgs:}${COMP_WORDS[i+1]//,/:}"
    fi
  done
  if [[ -n "$cfgs" ]]; then
    KUBECONFIG="$cfgs" kubectl config get-contexts -o name 2>/dev/null
  else
    kubectl config get-contexts -o name 2>/dev/null
  fi
}

_kubectl_knit() {
  local cur prev cmd
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  COMPREPLY=()

  if [[ "$COMP_CWORD" -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "import merge export split delete completion version help" -- "$cur") )
    return
  fi

  cmd="${COMP_WORDS[1]}"
  case "$cmd" in
    import)
      if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "--preserve-structure --save --force --stdin --help" -- "$cur") )
      fi
      ;;
    merge)
      if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "--preserve-structure --help" -- "$cur") )
      fi
      ;;
    export|split)
      if [[ "$prev" == '-k' || "$prev" == '--kubeconfig' ]]; then
        return
      elif [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "--kubeconfig --help" -- "$cur") )
      else
        COMPREPLY=( $(compgen -W "$(_kubectl_knit_contexts)" -- "$cur") )
      fi
      ;;
    delete)
      if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "--save --context-only --help" -- "$cur") )
      else
        COMPREPLY=( $(compgen -W "$(_kubectl_knit_contexts)" -- "$cur") )
      fi
      ;;
    completion)
      COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
      ;;
  esac
}

complete -o default -F _kubectl_knit kubectl-knit
COMPLETION
}

error() {
  echo "🔴 error: $*" >&2
  exit 1
}

warn() {
  echo "⚠️  warning: $*" >&2
}

info() {
  echo "$*" >&2
}

# join_by SEP ARG.. prints ARGs joined by SEP
join_by() {
  local IFS="$1"
  shift
  echo "$*"
}

init_workdir() {
  WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/kubectl-knit.XXXXXX")" \
    || error "cannot create a temporary directory, check TMPDIR"
}

# kubectl_out FILE ARG.. runs kubectl and writes its stdout to FILE.
# Piped through cat, as sandboxed kubectl (snap) can't write to redirected stdout.
kubectl_out() {
  local out="$1"
  shift
  "$KUBECTL" "$@" | cat > "$out"
}

# kubectl_quiet ARG.. runs kubectl and only shows its output on errors
kubectl_quiet() {
  if ! "$KUBECTL" "$@" > "$WORKDIR/kubectl.log" 2>&1; then
    cat "$WORKDIR/kubectl.log" >&2
    exit 1
  fi
}

# view_merged FILE MODE CONFIG.. merges CONFIGs into FILE. MODE is --raw or --flatten.
view_merged() {
  local out="$1" mode="$2"
  shift 2
  KUBECONFIG="$(join_by ':' "$@")" kubectl_out "$out" config view "$mode" --merge
}

# check_readable CONFIG.. fails unless all CONFIGs can be read (kubectl ignores missing files)
check_readable() {
  local f
  for f in "$@"; do
    if [[ -d "$f" ]]; then
      error "\"$f\" is a directory, not a kubeconfig"
    elif [[ ! -e "$f" ]]; then
      error "kubeconfig \"$f\" does not exist"
    elif [[ ! -r "$f" ]]; then
      error "kubeconfig \"$f\" is not readable"
    fi
  done
}

# target_kubeconfig prints the first file in KUBECONFIG, or ~/.kube/config
target_kubeconfig() {
  local -a entries=()
  local entry
  if [[ -n "${KUBECONFIG:-}" ]]; then
    IFS=':' read -r -a entries <<< "$KUBECONFIG"
    for entry in ${entries[@]+"${entries[@]}"}; do
      if [[ -n "$entry" ]]; then
        echo "$entry"
        return
      fi
    done
  fi
  echo "$HOME/.kube/config"
}

# save_to SRC DEST overwrites DEST in place (keeps symlinks and permissions),
# restoring it on failure.
save_to() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")" || error "cannot create directory for \"$dest\""
  if [[ -e "$dest" ]]; then
    cat "$dest" > "$WORKDIR/backup"
  else
    (umask 077 && : > "$dest") || error "cannot create \"$dest\""
    : > "$WORKDIR/backup"
  fi
  if ! cat "$src" > "$dest"; then
    cat "$WORKDIR/backup" > "$dest" || true
    error "cannot write \"$dest\""
  fi
}

# absolute_dir FILE prints the absolute directory which contains FILE
absolute_dir() {
  (cd "$(dirname "$1")" && pwd -P)
}

is_relative_path() {
  [[ -n "$1" && "$1" != /* ]]
}

# absolutize_paths CONFIG DIR makes relative certificate paths in CONFIG absolute to DIR
absolutize_paths() {
  local cfg="$1" dir="$2" name path
  local paths="$WORKDIR/paths"

  kubectl_out "$paths" --kubeconfig "$cfg" config view --raw \
    -o 'jsonpath={range .clusters[*]}{.name}{"\t"}{.cluster.certificate-authority}{"\n"}{end}'
  while IFS=$'\t' read -r name path; do
    if is_relative_path "$path"; then
      kubectl_quiet --kubeconfig "$cfg" config set-cluster "$name" --certificate-authority="$dir/$path"
    fi
  done < "$paths"

  kubectl_out "$paths" --kubeconfig "$cfg" config view --raw \
    -o 'jsonpath={range .users[*]}{.name}{"\t"}{.user.client-certificate}{"\n"}{end}'
  while IFS=$'\t' read -r name path; do
    if is_relative_path "$path"; then
      kubectl_quiet --kubeconfig "$cfg" config set-credentials "$name" --client-certificate="$dir/$path"
    fi
  done < "$paths"

  kubectl_out "$paths" --kubeconfig "$cfg" config view --raw \
    -o 'jsonpath={range .users[*]}{.name}{"\t"}{.user.client-key}{"\n"}{end}'
  while IFS=$'\t' read -r name path; do
    if is_relative_path "$path"; then
      kubectl_quiet --kubeconfig "$cfg" config set-credentials "$name" --client-key="$dir/$path"
    fi
  done < "$paths"
}

# list_entries CONFIG OUT writes "kind<TAB>name<TAB>data" per entry of CONFIG to OUT
list_entries() {
  kubectl_out "$2" --kubeconfig "$1" config view --raw -o 'jsonpath={range .clusters[*]}cluster{"\t"}{.name}{"\t"}{.cluster}{"\n"}{end}{range .users[*]}user{"\t"}{.name}{"\t"}{.user}{"\n"}{end}{range .contexts[*]}context{"\t"}{.name}{"\t"}{.context}{"\n"}{end}'
}

# report_conflicts BASE IMPORTED TARGET FORCE warns about same-named entries with different data
report_conflicts() {
  local base="$1" imported="$2" target="$3" force="$4" kind name

  list_entries "$base" "$WORKDIR/base.entries"
  list_entries "$imported" "$WORKDIR/import.entries"
  awk -F'\t' '
    NR == FNR { seen[$1 FS $2] = $3; next }
    (($1 FS $2) in seen) && seen[$1 FS $2] != $3 { print $1 "\t" $2 }
  ' "$WORKDIR/base.entries" "$WORKDIR/import.entries" > "$WORKDIR/conflicts"

  while IFS=$'\t' read -r kind name; do
    if [[ -n "$force" ]]; then
      warn "overwriting $kind \"$name\" in $target"
    else
      warn "$kind \"$name\" already exists in $target with different settings, keeping the existing one (use --force to overwrite)"
    fi
  done < "$WORKDIR/conflicts"
}

merge() {
  local mode="--flatten"
  local -a cfgs=()

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -p | --preserve-structure)
        mode="--raw"
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        cfgs+=( "$@" )
        break
        ;;
      -?*)
        error "unrecognized flag \"$1\""
        ;;
      *)
        cfgs+=( "$1" )
        ;;
    esac
    shift
  done

  if [[ "${#cfgs[@]}" -eq 0 ]]; then
    error "kubeconfigs to merge are missing"
  fi
  check_readable "${cfgs[@]}"

  init_workdir
  view_merged "$WORKDIR/result" "$mode" "${cfgs[@]}"
  cat "$WORKDIR/result"
}

import_ctx() {
  local mode="--flatten" save="" force="" use_stdin=""
  local target base current_context i
  local -a inputs=()
  local -a prepared=()

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -p | --preserve-structure)
        mode="--raw"
        ;;
      -s | --save)
        save=1
        ;;
      -f | --force)
        force=1
        ;;
      -i | --stdin | -)
        use_stdin=1
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        inputs+=( "$@" )
        break
        ;;
      -?*)
        error "unrecognized flag \"$1\""
        ;;
      *)
        inputs+=( "$1" )
        ;;
    esac
    shift
  done

  if [[ -z "$use_stdin" && "${#inputs[@]}" -eq 0 ]]; then
    error "kubeconfigs to import are missing"
  fi
  check_readable ${inputs[@]+"${inputs[@]}"}

  init_workdir
  target="$(target_kubeconfig)"
  if [[ -e "$target" ]]; then
    check_readable "$target"
    base="$target"
  else
    base="$WORKDIR/empty"
    : > "$base"
  fi

  # Copy all inputs, so that they can be validated and modified safely.
  if [[ -n "$use_stdin" ]]; then
    if [[ -t 0 ]]; then
      error "--stdin is given, but stdin is a terminal"
    fi
    cat > "$WORKDIR/stdin"
    if [[ ! -s "$WORKDIR/stdin" ]]; then
      error "no kubeconfig received on stdin"
    fi
    prepared+=( "$WORKDIR/stdin" )
  fi
  for i in ${inputs[@]+"${inputs[@]}"}; do
    cat -- "$i" > "$WORKDIR/input-${#prepared[@]}"
    prepared+=( "$WORKDIR/input-${#prepared[@]}" )
  done

  for i in "${!prepared[@]}"; do
    local cfg="${prepared[i]}" label dir
    if [[ -n "$use_stdin" && "$i" -eq 0 ]]; then
      label="<stdin>"
      dir="$PWD"
    else
      label="${inputs[i - ${use_stdin:-0}]}"
      dir="$(absolute_dir "$label")"
    fi

    if ! "$KUBECTL" config view --kubeconfig "$cfg" > /dev/null 2> "$WORKDIR/kubectl.log"; then
      error "\"$label\" is not a valid kubeconfig: $(cat "$WORKDIR/kubectl.log")"
    fi
    absolutize_paths "$cfg" "$dir"
    report_conflicts "$base" "$cfg" "$target" "$force"
  done

  # On name clashes, kubectl keeps the entry from the first file.
  if [[ -n "$force" ]]; then
    if ! view_merged "$WORKDIR/result" "$mode" "${prepared[@]}" "$base"; then
      error "cannot merge kubeconfigs (if a certificate file is missing, try --preserve-structure)"
    fi
    # Do not let the imported configs change the active context.
    kubectl_out "$WORKDIR/current-context" --kubeconfig "$base" config view -o 'jsonpath={.current-context}'
    current_context="$(cat "$WORKDIR/current-context")"
    if [[ -n "$current_context" ]]; then
      kubectl_quiet --kubeconfig "$WORKDIR/result" config use-context "$current_context"
    fi
  else
    if ! view_merged "$WORKDIR/result" "$mode" "$base" "${prepared[@]}"; then
      error "cannot merge kubeconfigs (if a certificate file is missing, try --preserve-structure)"
    fi
  fi

  if [[ -n "$save" ]]; then
    save_to "$WORKDIR/result" "$target"
    info "imported ${#prepared[@]} kubeconfig(s) into $target ✅"
  else
    cat "$WORKDIR/result"
  fi
}

delete_contexts() {
  local save="" context_only="" target result ctx cluster user current_context entry
  local -a ctxs=()
  local -a clusters=()
  local -a users=()
  local -a deleted=()

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -s | --save)
        save=1
        ;;
      -c | --context-only)
        context_only=1
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        ctxs+=( "$@" )
        break
        ;;
      -?*)
        error "unrecognized flag \"$1\""
        ;;
      *)
        ctxs+=( "$1" )
        ;;
    esac
    shift
  done

  if [[ "${#ctxs[@]}" -eq 0 ]]; then
    error "contexts to delete are missing"
  fi

  init_workdir
  target="$(target_kubeconfig)"
  check_readable "$target"
  result="$WORKDIR/result"
  cat "$target" > "$result"

  # one line "name<TAB>cluster<TAB>user" per context
  kubectl_out "$WORKDIR/contexts" --kubeconfig "$result" config view --raw \
    -o 'jsonpath={range .contexts[*]}{.name}{"\t"}{.context.cluster}{"\t"}{.context.user}{"\n"}{end}'

  # Validate all contexts before changing anything.
  for ctx in "${ctxs[@]}"; do
    if ! NAME="$ctx" awk -F'\t' '$1 == ENVIRON["NAME"] { found = 1 } END { exit !found }' "$WORKDIR/contexts"; then
      error "context \"$ctx\" not found in $target"
    fi
  done

  kubectl_out "$WORKDIR/current-context" --kubeconfig "$result" config view -o 'jsonpath={.current-context}'
  current_context="$(cat "$WORKDIR/current-context")"

  for ctx in "${ctxs[@]}"; do
    cluster="$(NAME="$ctx" awk -F'\t' '$1 == ENVIRON["NAME"] { print $2; exit }' "$WORKDIR/contexts")"
    user="$(NAME="$ctx" awk -F'\t' '$1 == ENVIRON["NAME"] { print $3; exit }' "$WORKDIR/contexts")"
    clusters+=( "$cluster" )
    users+=( "$user" )

    kubectl_quiet --kubeconfig "$result" config delete-context "$ctx"
    deleted+=( "context \"$ctx\"" )
    if [[ "$ctx" == "$current_context" ]]; then
      kubectl_quiet --kubeconfig "$result" config unset current-context
      warn "\"$ctx\" was the current context, select a new one with \"kubectl config use-context\""
    fi
  done

  if [[ -z "$context_only" ]]; then
    delete_orphans "$result" cluster ${clusters[@]+"${clusters[@]}"}
    delete_orphans "$result" user ${users[@]+"${users[@]}"}
  fi

  if [[ -n "$save" ]]; then
    save_to "$result" "$target"
    for entry in "${deleted[@]}"; do
      info "deleted $entry ✅"
    done
  else
    for entry in "${deleted[@]}"; do
      info "would delete $entry"
    done
    info "nothing was changed, use --save to delete from $target"
    # print the resulting kubeconfig only when it is redirected or piped
    if [[ ! -t 1 ]]; then
      cat "$result"
    fi
  fi
}

# delete_orphans CONFIG KIND NAME.. deletes unused clusters or users NAME from CONFIG
# and appends them to the caller's "deleted" array.
delete_orphans() {
  local cfg="$1" kind="$2" name column
  shift 2
  if [[ "$kind" == 'cluster' ]]; then
    column=2
  else
    column=3
  fi

  kubectl_out "$WORKDIR/contexts" --kubeconfig "$cfg" config view --raw \
    -o 'jsonpath={range .contexts[*]}{.name}{"\t"}{.context.cluster}{"\t"}{.context.user}{"\n"}{end}'
  kubectl_out "$WORKDIR/names" --kubeconfig "$cfg" config view --raw \
    -o "jsonpath={range .${kind}s[*]}{.name}{\"\\n\"}{end}"

  for name in "$@"; do
    if [[ -z "$name" ]] || ! grep -qxF -- "$name" "$WORKDIR/names"; then
      continue
    fi
    if NAME="$name" awk -F'\t' -v col="$column" '$col == ENVIRON["NAME"] { found = 1 } END { exit !found }' "$WORKDIR/contexts"; then
      continue
    fi
    if [[ "$kind" == 'cluster' ]]; then
      kubectl_quiet --kubeconfig "$cfg" config delete-cluster "$name"
    elif ! "$KUBECTL" --kubeconfig "$cfg" config delete-user "$name" > /dev/null 2>&1; then
      # kubectl before v1.24 does not know "delete-user"
      kubectl_quiet --kubeconfig "$cfg" config unset "users.$name"
    fi
    # do not delete the same entry twice
    printf '%s\n' "$name" | grep -vxF -f - "$WORKDIR/names" > "$WORKDIR/names.new" || true
    mv "$WORKDIR/names.new" "$WORKDIR/names"
    deleted+=( "$kind \"$name\"" )
  done
}

export_contexts() {
  local ctx i
  local -a ctxs=()
  local -a cfgs=()
  local -a tmpcfgs=()

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -k | --kubeconfig)
        if [[ "$#" -lt 2 || -z "$2" ]]; then
          error "flag \"$1\" requires a kubeconfig"
        fi
        cfgs+=( "${2//,/:}" )
        shift
        ;;
      --kubeconfig=*)
        local cfg="${1#--kubeconfig=}"
        cfgs+=( "${cfg//,/:}" )
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        ctxs+=( "$@" )
        break
        ;;
      -?*)
        error "unrecognized flag \"$1\""
        ;;
      *)
        ctxs+=( "$1" )
        ;;
    esac
    shift
  done

  if [[ "${#ctxs[@]}" -eq 0 ]]; then
    error "contexts to export are missing"
  fi
  if [[ "${#cfgs[@]}" -gt 0 ]]; then
    local -a files=()
    IFS=':' read -r -a files <<< "$(join_by ':' "${cfgs[@]}")"
    check_readable "${files[@]}"
  fi

  init_workdir
  i=0
  for ctx in "${ctxs[@]}"; do
    tmpcfgs+=( "$WORKDIR/context-$i" )
    if [[ "${#cfgs[@]}" -eq 0 ]]; then
      kubectl_out "$WORKDIR/context-$i" config view --flatten --minify --context="$ctx"
    else
      KUBECONFIG="$(join_by ':' "${cfgs[@]}")" \
        kubectl_out "$WORKDIR/context-$i" config view --flatten --minify --context="$ctx"
    fi
    i=$((i + 1))
  done

  view_merged "$WORKDIR/result" --flatten "${tmpcfgs[@]}"
  cat "$WORKDIR/result"
}

main() {
  if [[ -n "${KNIT_KUBECTL:-}" ]]; then
    KUBECTL="$KNIT_KUBECTL"
  elif hash kubectl 2>/dev/null; then
    KUBECTL=kubectl
  elif hash kubectl.exe 2>/dev/null; then
    KUBECTL=kubectl.exe
  else
    error "kubectl is not installed"
  fi

  if [[ "$#" -eq 0 ]]; then
    usage
    return
  fi

  case "$1" in
  '-h' | '--help' | 'help')
    usage
    ;;
  '-v' | '--version' | 'version')
    echo "kubectl-knit $KNIT_VERSION"
    ;;
  'export'|'split')
    export_contexts "${@:2}"
    ;;
  'import')
    import_ctx "${@:2}"
    ;;
  'merge')
    merge "${@:2}"
    ;;
  'delete')
    delete_contexts "${@:2}"
    ;;
  'completion')
    completion "${@:2}"
    ;;
   -*)
    usage
    error "unrecognized flag \"${1}\""
    ;;
   *)
    usage
    error "unknown command \"$1\""
  esac

}

main "$@"
